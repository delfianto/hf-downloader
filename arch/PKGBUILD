pkgname=hf-downloader
pkgver=0.3.1
pkgrel=2
pkgdesc='Flat-file downloader for Hugging Face model artifacts'
arch=('x86_64')
url='https://github.com/delfianto/hf-downloader'
license=('MIT')
depends=('glibc' 'libgcc' 'ca-certificates')
provides=("huggingface-downloader-bin=$pkgver-$pkgrel" "huggingface-downloader=$pkgver-$pkgrel" "huggingface-dl=$pkgver-$pkgrel" "huggingface-dl-bin=$pkgver-$pkgrel")
conflicts=('huggingface-downloader-bin' 'huggingface-downloader' 'huggingface-dl' 'huggingface-dl-bin')
replaces=('huggingface-downloader-bin' 'huggingface-dl-bin')
options=('!strip' '!debug')
_archive="huggingface-downloader-v$pkgver-linux-x86_64"
source=("$url/releases/download/arch-v$pkgver-$pkgrel/$_archive.tar.gz")
sha256sums=('1e1d3d5c7872ce2d4f17940b49955251c0eb3da4e11f488fa17f04db7665027f')

package() {
    cd "$srcdir/$_archive"
    install -Dm0755 hfdl "$pkgdir/usr/bin/hfdl"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
