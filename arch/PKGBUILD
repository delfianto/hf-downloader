pkgname=huggingface-downloader-bin
pkgver=0.3.0
pkgrel=1
pkgdesc='Flat-file downloader for Hugging Face model artifacts'
arch=('x86_64')
url='https://github.com/delfianto/huggingface-downloader'
license=('MIT')
depends=('glibc' 'libgcc' 'ca-certificates')
provides=("huggingface-downloader=$pkgver" "huggingface-dl=$pkgver" "huggingface-dl-bin=$pkgver")
conflicts=('huggingface-downloader' 'huggingface-dl' 'huggingface-dl-bin')
replaces=('huggingface-dl-bin')
options=('!strip' '!debug')
_archive="huggingface-downloader-v$pkgver-linux-x86_64"
source=("$url/releases/download/v$pkgver/$_archive.tar.gz")
sha256sums=('212dd9e866035022b3592b6e3c964442c4cb9b583fba5c818f554628745c0924')

package() {
    cd "$srcdir/$_archive"
    install -Dm0755 hfdl "$pkgdir/usr/local/bin/hfdl"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
